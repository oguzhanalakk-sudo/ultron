import { execFile } from 'node:child_process'
import { promisify } from 'node:util'
import { buildProjectSpec, type ProjectStack } from './project-template-registry.ts'

const execFileAsync = promisify(execFile)

export type VerificationResult = {
  ok: boolean
  command: string
  stdout: string
  stderr: string
  exitCode: number | null
}

export async function runVerification(root: string, command: string, args: string[]): Promise<VerificationResult> {
  try {
    const child = await execFileAsync(command, args, { cwd: root, maxBuffer: 1_000_000 })
    return {
      ok: true,
      command: [command, ...args].join(' '),
      stdout: String(child.stdout ?? ''),
      stderr: String(child.stderr ?? ''),
      exitCode: 0,
    }
  } catch (error: any) {
    const result = error && typeof error === 'object' && 'stdout' in error ? error : { stdout: '', stderr: '', code: 1 }
    return {
      ok: false,
      command: [command, ...args].join(' '),
      stdout: String((result as any).stdout ?? ''),
      stderr: String((result as any).stderr ?? ''),
      exitCode: typeof (result as any).code === 'number' ? (result as any).code : 1,
    }
  }
}

function resolveCommands(stack: string): { install: string[]; build: string[] } {
  const safeStack = (stack as ProjectStack) ?? 'vite'
  const spec = buildProjectSpec({ stack: safeStack })

  if (spec.packageManager === 'pip') {
    return {
      install: ['python', '-m', 'pip', 'install', '-r', 'requirements.txt'],
      build: ['python', '-m', 'py_compile', 'app.py'],
    }
  }

  return {
    install: ['npm', 'install'],
    build: ['npm', 'run', 'build'],
  }
}

export async function installProjectDependencies(root: string, stack: string): Promise<VerificationResult> {
  const { install } = resolveCommands(stack)
  return runVerification(root, install[0], install.slice(1))
}

export async function validateGeneratedBuild(root: string, stack: string): Promise<VerificationResult> {
  const { build } = resolveCommands(stack)
  return runVerification(root, build[0], build.slice(1))
}

export async function verifyGeneratedProject(root: string, stack: string, install: boolean): Promise<{ ok: boolean; summary: string[]; results: VerificationResult[] }> {
  const summary: string[] = []
  const results: VerificationResult[] = []

  if (install) {
    const installResult = await installProjectDependencies(root, stack)
    results.push(installResult)
    summary.push(installResult.ok ? 'Bağımlılıklar başarıyla kuruldu.' : 'Bağımlılık kurulumu başarısız oldu.')
  }

  const buildResult = await validateGeneratedBuild(root, stack)
  results.push(buildResult)
  summary.push(buildResult.ok ? 'Build doğrulaması başarılı.' : 'Build doğrulaması başarısız.')

  return {
    ok: results.every((item) => item.ok),
    summary,
    results,
  }
}

export async function verifyProjectGeneration(root: string, stack: string, install = false): Promise<{ ok: boolean; summary: string[]; results: VerificationResult[] }> {
  return verifyGeneratedProject(root, stack, install)
}
